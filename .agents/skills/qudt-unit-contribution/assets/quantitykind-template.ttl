@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix qkdv: <http://qudt.org/vocab/dimensionvector/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

quantitykind:{{QNAME}}
  a qudt:QuantityKind ;
  dcterms:description "{{DESCRIPTION}}" ;
  qudt:hasDimensionVector qkdv:{{DIMENSION_VECTOR}} ;
  qudt:plainTextDescription "{{PLAIN_TEXT_DESCRIPTION}}" ;
  qudt:{{HIERARCHY_RELATION}} quantitykind:{{BROADER_QUANTITY_KIND}} ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/vocab/quantitykind> ;
  rdfs:label "{{LABEL}}"@en .
