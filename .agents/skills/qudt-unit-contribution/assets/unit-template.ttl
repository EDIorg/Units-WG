@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix qkdv: <http://qudt.org/vocab/dimensionvector/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix unit: <http://qudt.org/vocab/unit/> .

unit:{{QNAME}}
  a qudt:DerivedUnit, qudt:Unit ;
  dcterms:description "{{DESCRIPTION}}" ;
  qudt:conversionMultiplier {{DECIMAL_MULTIPLIER}} ;
  qudt:conversionMultiplierSN {{SCIENTIFIC_MULTIPLIER}} ;
  qudt:expression "{{LATEX_EXPRESSION}}"^^qudt:LatexString ;
  qudt:hasDimensionVector qkdv:{{DIMENSION_VECTOR}} ;
  qudt:hasFactorUnit [
      qudt:exponent {{FACTOR_1_EXPONENT}} ;
      qudt:hasUnit unit:{{FACTOR_1_UNIT}} ;
    ] ;
  qudt:hasFactorUnit [
      qudt:exponent {{FACTOR_2_EXPONENT}} ;
      qudt:hasUnit unit:{{FACTOR_2_UNIT}} ;
    ] ;
  qudt:plainTextDescription "{{PLAIN_TEXT_DESCRIPTION}}" ;
  qudt:unitForQuantityKind quantitykind:{{QUANTITY_KIND}} ;
  qudt:symbol "{{SYMBOL}}" ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/vocab/unit> ;
  rdfs:label "{{LABEL}}"@en .
