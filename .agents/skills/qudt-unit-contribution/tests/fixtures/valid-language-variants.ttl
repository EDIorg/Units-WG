@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix qkdv: <http://qudt.org/vocab/dimensionvector/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix unit: <http://qudt.org/vocab/unit/> .

unit:LanguageVariantTest
  a qudt:Unit ;
  dcterms:description "English description with an intentional tag"@en ;
  qudt:conversionMultiplier 1.0 ;
  qudt:conversionMultiplierSN 1.0E0 ;
  qudt:hasDimensionVector qkdv:A0E0L1I0M0H0T0D0 ;
  qudt:hasQuantityKind quantitykind:Length ;
  qudt:plainTextDescription "Test description"@en ;
  qudt:symbol "lvt" ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/vocab/unit> ;
  rdfs:label "Language Variant Test" .