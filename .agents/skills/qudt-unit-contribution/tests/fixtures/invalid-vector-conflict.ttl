@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix qkdv: <http://qudt.org/vocab/dimensionvector/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix unit: <http://qudt.org/vocab/unit/> .

unit:ConflictingUnit
  a qudt:Unit ;
  dcterms:description "Unit with conflicting draft semantics" ;
  qudt:conversionMultiplier 1.0 ;
  qudt:conversionMultiplierSN 1.0E0 ;
  qudt:hasDimensionVector qkdv:A0E0L1I0M0H0T0D0 ;
  qudt:hasQuantityKind quantitykind:ConflictingQuantityKind ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/vocab/unit> ;
  rdfs:label "Conflicting Unit"@en .

quantitykind:ConflictingQuantityKind
  a qudt:QuantityKind ;
  qudt:hasDimensionVector qkdv:A0E0L0I0M0H0T1D0 ;
  qudt:plainTextDescription "QuantityKind with a conflicting vector" ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/vocab/quantitykind> ;
  rdfs:label "Conflicting Quantity Kind"@en .