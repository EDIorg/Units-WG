@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix qkdv: <http://qudt.org/vocab/dimensionvector/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix unit: <http://qudt.org/vocab/unit/> .

unit:M-PER-M2-Test
  a qudt:DerivedUnit, qudt:Unit ;
  dcterms:description "Compound test unit" ;
  qudt:conversionMultiplier 1.0 ;
  qudt:conversionMultiplierSN 1.0E0 ;
  qudt:expression "$m/m^2$"^^qudt:LatexString ;
  qudt:hasDimensionVector qkdv:A0E0L-1I0M0H0T0D0 ;
  qudt:hasFactorUnit [
      qudt:exponent 1 ;
      qudt:hasUnit unit:M ;
    ] ;
  qudt:hasFactorUnit [
      qudt:exponent -2 ;
      qudt:hasUnit unit:M ;
    ] ;
  qudt:plainTextDescription "Compound test unit" ;
  qudt:symbol "m/m²" ;
  qudt:unitForQuantityKind quantitykind:InverseLength ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/vocab/unit> ;
  rdfs:label "Metre per Square Metre Test"@en .
