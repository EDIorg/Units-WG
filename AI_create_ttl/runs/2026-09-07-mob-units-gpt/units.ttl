@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix qkdv: <http://qudt.org/vocab/dimensionvector/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix unit: <http://qudt.org/vocab/unit/> .

unit:KiloM-PER-KiloM2
  a qudt:DerivedUnit, qudt:Unit ;
  dcterms:description "A unit of inverse length expressed as km/km², equal to 0.001 reciprocal metre." ;
  qudt:conversionMultiplier 0.001 ;
  qudt:conversionMultiplierSN 1E-3 ;
  qudt:expression "$km/km²$"^^qudt:LatexString ;
  qudt:hasDimensionVector qkdv:A0E0L-1I0M0H0T0D0 ;
  qudt:hasFactorUnit [
      qudt:exponent 1 ;
      qudt:hasUnit unit:KiloM ;
    ] ;
  qudt:hasFactorUnit [
      qudt:exponent -2 ;
      qudt:hasUnit unit:KiloM ;
    ] ;
  qudt:plainTextDescription "A unit of inverse length expressed as km/km², equal to 0.001 reciprocal metre." ;
  qudt:symbol "km/km²" ;
  qudt:unitForQuantityKind quantitykind:InverseLength ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/vocab/unit> ;
  rdfs:label "Kilometer per Square Kilometer"@en-US ;
  rdfs:label "Kilometre per Square Kilometre"@en .

unit:M2-PER-M3
  a qudt:DerivedUnit, qudt:Unit ;
  dcterms:description "A unit of inverse length expressed as m²/m³, equal to 1.0 reciprocal metre." ;
  qudt:conversionMultiplier 1.0 ;
  qudt:conversionMultiplierSN 1E+0 ;
  qudt:expression "$m²/m³$"^^qudt:LatexString ;
  qudt:hasDimensionVector qkdv:A0E0L-1I0M0H0T0D0 ;
  qudt:hasFactorUnit [
      qudt:exponent 2 ;
      qudt:hasUnit unit:M ;
    ] ;
  qudt:hasFactorUnit [
      qudt:exponent -3 ;
      qudt:hasUnit unit:M ;
    ] ;
  qudt:plainTextDescription "A unit of inverse length expressed as m²/m³, equal to 1.0 reciprocal metre." ;
  qudt:symbol "m²/m³" ;
  qudt:unitForQuantityKind quantitykind:InverseLength ;
  rdfs:isDefinedBy <http://qudt.org/$$QUDT_VERSION$$/vocab/unit> ;
  rdfs:label "Square Meter per Cubic Meter"@en-US ;
  rdfs:label "Square Metre per Cubic Metre"@en .

unit:KiloJ-PER-M2
  a qudt:DerivedUnit, qudt:Unit ;
  dcterms:description "A unit of energy per area expressed as kJ/m², equal to 1000.0 joule per square metre." ;
