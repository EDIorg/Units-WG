    ] ;
  qudt:hasFactorUnit [
      qudt:exponent -2 ;
      qudt:hasUnit unit:M ;
    ] ;
  qudt:plainTextDescription "A unit of energy per area expressed as kJ/m², equal to 1000.0 joule per square metre." ;
  qudt:symbol "kJ/m²" ;
  qudt:unitForQuantityKind quantitykind:EnergyFluence ;
  qudt:unitForQuantityKind quantitykind:EnergyPerArea ;
  qudt:unitForQuantityKind quantitykind:RadiantFluence ;
  qudt:unitForQuantityKind quantitykind:StrainEnergyReleaseRate ;
